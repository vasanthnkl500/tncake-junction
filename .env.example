# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# GMAIL SMTP EMAIL DELIVERY CONFIGURATION (SERVER ENVIRONMENT SECRETS)
# ==============================================================================
# Live SMTP delivery for customer OTPs, password reset links, and security alerts.
# Configured for sender vasanthnkl500@gmail.com.
# Keep these credentials strictly server-side. Never expose in frontend code.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="vasanthnkl500@gmail.com"
# Configure your 16-character Gmail App Password here (from myaccount.google.com -> Security -> 2-Step -> App passwords):
SMTP_PASS=""
SMTP_FROM="Cake Junction <vasanthnkl500@gmail.com>"
TEST_EMAIL="dhanushya1702@gmail.com"

# ==============================================================================
# GOOGLE DRIVE BACKUP & OAUTH INTEGRATION (TARGET ACCOUNT: vasanthnkl500@gmail.com)
# ==============================================================================
# Drive authorization is completed via the authorized Google Sign-In button in the Owner Dashboard.
# OAuth scopes: https://www.googleapis.com/auth/drive.file
# Backups are created in private folder 'Cake Junction Secure Backups'
# Optional AES-256 backup encryption secret key:
BACKUP_ENCRYPTION_KEY="cake-junction-aes-256-backup-key-2026"

# ==============================================================================
# OWNER AUTHENTICATION & RECOVERY (SERVER ENVIRONMENT SECRETS)
# ==============================================================================
# Owner account contact details and optional recovery override key.
OWNER_EMAIL="vasanthnkl500@gmail.com"
OWNER_PHONE="8825648728"
# Optional server-side master emergency recovery key (CJ-XXXX-XXXX-XXXX):
OWNER_RECOVERY_KEY=""

# ==============================================================================
# SMS & OTP GATEWAY CONFIGURATION (BACKEND ENVIRONMENT SECRETS)
# ==============================================================================
# Never expose these credentials in frontend code, public repositories, or client settings.
# Configure them in your server environment variables or deployment secret manager.

# Provider selection: 'fast2sms' (recommended for quick Indian OTP setup) or 'msg91' (DLT compliant)
SMS_PROVIDER="fast2sms"

# Fast2SMS API Key:
# Sign up at https://www.fast2sms.com/ -> Dev API -> Copy Authorization Key
# Fast2SMS Quick OTP route supports automated 6-digit verification without prior DLT registration.
FAST2SMS_API_KEY=""

# MSG91 Auth Key (Optional alternative DLT-compliant gateway):
# Sign up at https://msg91.com/ -> Copy Auth Key
MSG91_AUTH_KEY=""

# MSG91 Content Template ID (Required when using MSG91):
# Registered OTP template ID from MSG91 dashboard (e.g., 64ab...)
MSG91_TEMPLATE_ID=""

# Optional TRAI DLT Registered Sender Header (e.g. CKJNCT for Cake Junction)
SMS_SENDER_ID="CKJNCT"

# Live SMS Dispatch Mode:
# 'true' enables live dispatch to Indian telecom carriers; 'false' disables external dispatch
SMS_LIVE_MODE="true"
